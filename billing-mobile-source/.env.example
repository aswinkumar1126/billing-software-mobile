# Copy this file to .env and set the value for your setup.
#
# Base URL of the Spring Boot backend (billing), WITHOUT the /api/v1 suffix
# (the API client appends that itself). See README.md for guidance on what
# to use for the Android emulator, iOS simulator, and physical devices.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
